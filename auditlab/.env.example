# Copier en .env et adapter avant la mise en production.
POSTGRES_PASSWORD=changer-ce-mot-de-passe
AUDITLAB_PORT=8080
# Clé de signature des liens de téléchargement : openssl rand -hex 32
AUDITLAB_SECRET_KEY=changer-cette-cle
MINIO_ROOT_USER=auditlab
MINIO_ROOT_PASSWORD=changer-ce-mot-de-passe
# Clé de chiffrement au repos de MinIO : "nom:" suivi de 32 octets en base64 (openssl rand -base64 32)
MINIO_KMS_SECRET_KEY=auditlab-key:remplacer-par-une-cle-base64
