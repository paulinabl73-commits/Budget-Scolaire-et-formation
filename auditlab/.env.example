# Copier en .env et adapter avant la mise en production.
POSTGRES_PASSWORD=changer-ce-mot-de-passe
AUDITLAB_PORT=8080
# Clé de signature des liens de téléchargement : openssl rand -hex 32
AUDITLAB_SECRET_KEY=changer-cette-cle
# Stockage S3 (SeaweedFS) : compte de l'application
S3_ACCESS_KEY=auditlab
S3_SECRET_KEY=changer-ce-mot-de-passe
# Clé de chiffrement au repos (SSE-S3) : 32 octets en hexadécimal (openssl rand -hex 32)
S3_SSE_KEK=remplacer-par-64-caracteres-hexadecimaux
# Clé de signature interne du stockage (openssl rand -base64 32)
S3_SIGNING_KEY=remplacer-par-une-cle-aleatoire
